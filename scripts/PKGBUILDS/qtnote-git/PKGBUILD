pkgname=anykeep-git
pkgver=nightly.0.g5da45c8
pkgrel=1
pkgdesc="Note-taking application written with Qt in mind"
arch=('i686' 'x86_64')
url="http://ri0n.github.io/AnyKeep"
license=('GPL3')
depends=('qt6-base' 'qt6-tools' 'hunspell' 'qt6-multimedia')
makedepends=('git' 'cmake')
optdepends=('kglobalaccel' 'kwindowsystem' 'knotifications' 'wl-clipboard')
conflicts=(qtnote qtnote-git anykeep)
source=("$pkgname"::"git+https://github.com/Ri0n/AnyKeep")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  # Use the tag of the last commit
  git describe --long --tags | sed 's/^v//;s/-/./g'
}

is_installed() {
    pacman -Q $1 &> /dev/null
}

prepare() {
    cd $pkgname
    git submodule update --init --recursive
    if is_installed "kglobalaccel" && is_installed "kwindowsystem" && is_installed "knotifications"; then
      makedepends+=('extra-cmake-modules' )
    fi
}

build() {
  # BUILD HERE
  cmake_flags="-DCMAKE_INSTALL_PREFIX=/usr -DQT_DEFAULT_MAJOR_VERSION=6"
  mkdir -p $srcdir/$pkgname/build && cd $srcdir/$pkgname/build
  cmake ${cmake_flags} ..
  cmake --build . --target all
}

package() {
  cd "$srcdir/$pkgname/build"
  make DESTDIR="$pkgdir"  install
}
