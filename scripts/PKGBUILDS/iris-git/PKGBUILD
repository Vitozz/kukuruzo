pkgname=iris-git
pkgver=1.3.0.g52b51b3d
pkgrel=1
pkgdesc='Qt6 XMPP network library'
arch=('x86_64' 'aarch64')
url='https://github.com/psi-im/iris'
license=('LGPL-2.1-only')
depends=('qt6-base' 'qca3-git' 'libomemo-c')
makedepends=('git' 'cmake' 'ninja')
provides=('iris')
conflicts=('iris')
source=('git+https://github.com/psi-im/iris.git')
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/iris" && git describe --long --tags | sed 's/^v//;s/-/./g'
}

build() {
    cmake -S iris -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_SHARED_LIBS=ON \
        -DIRIS_BUNDLED_USRSCTP=ON \
        -DQT_DEFAULT_MAJOR_VERSION=6 \
        -DBUILD_TESTING=OFF

    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    # Удаляем файлы CMake-конфигурации, если пакет нужен только
    # как системная библиотека для qmake/других проектов.
    # Обычно оставлять их полезнее, поэтому эта часть намеренно отключена.
}
